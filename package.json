{
  "name": "lazypr",
  "version": "1.6.1",
  "description": "Generate clean, consistent PRs from commits - powered by your favorite AI and your git history.",
  "keywords": [
    "ai",
    "cerebras",
    "cli",
    "git",
    "groq",
    "openai",
    "pull-request"
  ],
  "homepage": "https://lazypr.vercel.app",
  "bugs": {
    "url": "https://github.com/R4ULtv/lazypr/issues"
  },
  "license": "MIT",
  "author": "Raul Carini <contact@raulcarini.dev> (https://raulcarini.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/R4ULtv/lazypr.git"
  },
  "bin": {
    "lazypr": "dist/index.js",
    "lzp": "dist/lzp.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --format esm --minify",
    "postbuild": "echo '#!/usr/bin/env node\nimport(\"./index.js\");' > dist/lzp.js",
    "dev": "bun run index.ts",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^3.0.14",
    "@ai-sdk/google": "^4.0.21",
    "@ai-sdk/groq": "^4.0.13",
    "@ai-sdk/openai": "^4.0.17",
    "@clack/prompts": "^1.7.0",
    "ai": "^7.0.34",
    "commander": "^15.0.0",
    "tinyclip": "^0.1.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
