{
  "name": "lazypr",
  "version": "2.0.0",
  "description": "Generate clean, consistent PRs from commits with Qwen and your git history.",
  "keywords": [
    "ai",
    "cerebras",
    "cli",
    "git",
    "groq",
    "pull-request",
    "qwen"
  ],
  "homepage": "https://github.com/R4ULtv/lazypr",
  "bugs": {
    "url": "https://github.com/R4ULtv/lazypr/issues"
  },
  "license": "MIT",
  "author": "Raul Carini <contact@raulcarini.dev> (https://raulcarini.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/R4ULtv/lazypr.git"
  },
  "bin": {
    "lazypr": "dist/index.js",
    "lzp": "dist/lzp.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bun build index.ts --outdir dist --target node --format esm --minify",
    "postbuild": "echo '#!/usr/bin/env node\nimport(\"./index.js\");' > dist/lzp.js",
    "dev": "bun run index.ts",
    "start": "node dist/index.js",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "tinyclip": "^1.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
